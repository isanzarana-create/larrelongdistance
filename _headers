/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000

# Fotos de Instagram: el nombre incluye fecha e identificador, nunca se reutiliza
/fotos/*
  Cache-Control: public, max-age=31536000, immutable

# Fuentes alojadas: ficheros estables, caché de un año
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS, JS e imagen social: se revalidan cada día
/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-larre.jpg
  Cache-Control: public, max-age=604800

# Ficheros de trabajo que no deben aparecer en Google
/LEEME.md
  X-Robots-Tag: noindex, nofollow
/scripts/*
  X-Robots-Tag: noindex, nofollow
/gallery-captions.json
  X-Robots-Tag: noindex, nofollow
